#!/bin/sh /etc/rc.common
# lucky 动态域名 / 端口转发 / 内网穿透
# 参数沿用官方脚本：lucky -c <配置文件路径>

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/lucky
CONF_DIR=/etc/lucky
CONF=$CONF_DIR/lucky.conf

start_service() {
	mkdir -p "$CONF_DIR"
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/lucky.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lucky
}
